DATABASE_URL="postgresql://feelky:feelky@localhost:5432/feelky?schema=public"
# пряме підключення для міграцій (без pooler); локально збігається з DATABASE_URL
DIRECT_URL="postgresql://feelky:feelky@localhost:5432/feelky?schema=public"
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-random-secret"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
SEED_EMAIL="admin@example.com"
SEED_PASSWORD="change-me-please"

# Telegram bot (нічого з цього не комітиться з реальними значеннями)
# токен від @BotFather
TELEGRAM_BOT_TOKEN=""
# довільний секрет 32-64 символи: openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET=""
# email користувача Feelky, до якого прив'язаний бот
TELEGRAM_USER_EMAIL=""
# один або кілька Telegram user ID через кому
TELEGRAM_ALLOWED_USER_IDS=""
# публічний HTTPS-домен застосунку, без слеша в кінці
TELEGRAM_WEBHOOK_URL=""

# Доступ лише на читання для зовнішнього AI-агента (OpenClaw): openssl rand -hex 32
